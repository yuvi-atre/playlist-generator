# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# From your Spotify app dashboard (Settings → Client ID)
# Safe to expose — PKCE doesn't use a client secret.
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Optional — defaults to http://127.0.0.1:5173/callback for local dev.
# Must exactly match the redirect URI registered in your Spotify app dashboard.
# VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# Anthropic API key — backend only, NO VITE_ prefix (never expose to the browser)
ANTHROPIC_API_KEY=sk-ant-...

# Last.fm API key — used to backfill artist genres (Spotify's own /v1/artists
# endpoint 403s for this app). Safe to expose; used client-side.
# Get one at https://www.last.fm/api/account/create
VITE_LASTFM_API_KEY=your_lastfm_api_key_here

# From your Spotify app dashboard (Settings → Client Secret)
# Backend only — powers the Client Credentials token that verifies Discovery-
# mode proposals via Spotify Search. Without it, Discovery silently returns no
# results rather than erroring.
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Discord webhook URL — beta waitlist signups post here. Without it, the
# waitlist form returns a "not open yet" message instead of erroring.
# Create one: Discord server → Integrations → Webhooks → copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
